# Modèle : copier en .env (jamais versionné) et remplacer chaque changeme
# par une valeur aléatoire : openssl rand -base64 24 | tr '+/' '-_'

# MQTT : ESP / IA / supervision en MQTTS 8883 ; l'API en 1883 sur le réseau Docker
# interne uniquement (1883 n'est plus publié)
MQTT_USER=sentinel
MQTT_PASSWORD=changeme
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=changeme
MQTT_IA_USER=ia
MQTT_IA_PASSWORD=changeme

# API (DEV) : clé exigée sur POST /api/v1/alerts et /api/v1/commands (en-tête X-API-Key)
API_KEY=changeme

# Reverse proxy Caddy : authentification HTTP Basic du dashboard (HTTPS 443)
# Hachage bcrypt :  docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Entre APOSTROPHES SIMPLES : le hachage contient des « $ » que Compose interpréterait.
DASHBOARD_USER=changeme
DASHBOARD_PASSWORD_HASH='changeme'

# Point d'accès Wi-Fi de la table (wlan0) : à renseigner uniquement dans .env
# PSK : tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24   (WPA2, compatible ESP8266)
WIFI_AP_SSID=changeme
WIFI_AP_PSK=changeme

# Supervision du Pi (infra/monitoring/sentinel_monitor.py) : compte MQTT dédié
# Seuils facultatifs : MONITOR_TEMP_MAX, MONITOR_CPU_MAX, ... (voir infra/monitoring/README.md)
MQTT_MONITOR_USER=monitor
MQTT_MONITOR_PASSWORD=changeme
