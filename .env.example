# Modèle : copier en .env (jamais versionné) et remplacer chaque changeme
# par une valeur aléatoire : openssl rand -base64 24 | tr '+/' '-_'

# MQTT (TEMPORAIRE : 1883 en clair, passer en 8883/TLS avant jeudi)
MQTT_USER=sentinel
MQTT_PASSWORD=changeme
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=changeme
MQTT_IA_USER=ia
MQTT_IA_PASSWORD=changeme

# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
DB_PASSWORD=changeme

# Point d'accès Wi-Fi de la table (wlan0) : à renseigner uniquement dans .env
# PSK : tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24   (WPA2, compatible ESP8266)
WIFI_AP_SSID=changeme
WIFI_AP_PSK=changeme
