# Modèle de /etc/sentinel/ia.env (root:sentinel 640, jamais versionné).
# Variables du script IA UNIQUEMENT : pas de copie du .env complet de la pile.
# Remplacer chaque changeme par la valeur correspondante du .env.

# MQTTS (plus de 1883 : non publié). Hôte = IP du point d'accès (SAN du certificat).
MQTT_HOST=192.168.10.10
MQTT_PORT=8883
MQTT_CA_FILE=/home/sentinel/Workshop_grp10/infra/mosquitto/certs/ca.crt
MQTT_IA_USER=ia
MQTT_IA_PASSWORD=changeme
MQTT_TOPIC=sentinel/+/telemetry

# Alertes vers l'API : listener local de Caddy (127.0.0.1:3000), en-tête X-API-Key
API_URL=http://127.0.0.1:3000/api/v1/alerts
API_KEY=changeme

# Flux webcam Flask (UFW : équipe + passerelle Docker 172.30.0.1 pour Caddy)
WEBCAM_HOST=0.0.0.0
WEBCAM_PORT=8080
