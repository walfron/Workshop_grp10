# Contexte de build = racine du dépôt : liste blanche stricte.
# Rien d'autre n'est envoyé au démon Docker (.env, certificats, passwd, data...).
*
!backend/package.json
!backend/package-lock.json
!backend/src/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/public/
**/node_modules
**/.env*
