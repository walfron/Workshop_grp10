{
  "name": "sentinelx-backend",
  "version": "1.0.0",
  "description": "API REST + WebSocket du PC Serveur Local Sentinel-X : ingestion MQTT, historique, alertes, commandes",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate-esp.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "aedes": "^1.2.0",
    "express": "^5.2.1",
    "mqtt": "^5.16.0",
    "ws": "^8.22.0"
  }
}
